  "helper": {
    "path": "tools/asset_pipeline.py",
    "sha256": "39e021f3e98c53a6c77efed24051fab5f61d992b3b7910f8cc59f4d98df3293e",
    "function": "fit_albedo(image, (size, size), periodic=True)"
  },
  "operations": [
    "Open the complete owned source without cropping, color changes, sharpening or masks.",
    "Resize RGBA independently to each output size with Pillow LANCZOS.",
    "Apply the existing periodic_rgb row-then-column 24px edge correction. Center pixels outside the bands remain unchanged.",
    "Save RGBA PNG with optimize=False, compress_level=9. Keep only image container chunks."
  ],
  "environment": {
    "pillow": "12.3.0",
    "numpy": "2.5.3",
    "zlib": "1.3.2"
  },
  "native_contract": {
    "width": 256,
    "height": 256,
    "format": "BC7 sRGB",
    "array_depth": 16,
    "mip_count": 1,
    "filter": "Point",
    "wrap": "Repeat U/V/W",
    "anisotropy": 1,
    "mip_bias": 0
  },
  "limitations": [
    "Only the 256px versions have the current same-layout native array study. 512px and 1024px remain preparation inputs for a separate sampling/resolution policy.",
    "Equal base endpoints do not guarantee equal diagnostic mip endpoints or seamless compressed sampling.",
    "Original normal channels are retained controls, not authored companions.",
    "These layer roles are shared across biomes. Meadows material studies do not approve all shared use.",
    "Current runtime supports Texture2D albedo; terrain-array installation and lifecycle integration remain open."
  ],
